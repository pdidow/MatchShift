# MatchShift runs fully offline with NO keys. Everything below is optional.

# Microsoft Foundry (Azure AI Foundry) model deployment for narrative wording.
# Leave Foundry__Enabled=false to use the deterministic template provider.
Foundry__Enabled=false
Foundry__Endpoint=https://<your-resource>.services.ai.azure.com/openai/v1
Foundry__Deployment=<your-model-deployment-name>
# Leave empty to authenticate with Microsoft Entra ID (DefaultAzureCredential / managed identity).
Foundry__ApiKey=

# Application Insights (Azure Monitor OpenTelemetry). Omit to disable telemetry.
APPLICATIONINSIGHTS_CONNECTION_STRING=
