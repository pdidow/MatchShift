# MatchShift runs fully offline with NO keys. Everything below is optional.

# This file is documentation; it is not loaded automatically. See docs/FOUNDRY.md.
# Choose template, mock (offline protocol simulation), or foundry (production provider).
Narration__Provider=template
Narration__Workflow=collaborative

# Microsoft Foundry model deployment for evidence-bound editorial selection.
# Foundry mode needs Narration__Provider=foundry and Foundry__Enabled=true.
# No keys or deployment are needed for template or mock modes.
Foundry__Enabled=false
Foundry__Endpoint=https://<your-resource>.services.ai.azure.com/openai/v1
Foundry__Deployment=<your-model-deployment-name>
# Leave empty to authenticate with Microsoft Entra ID (DefaultAzureCredential / managed identity).
Foundry__ApiKey=

# Application Insights (Azure Monitor OpenTelemetry). Omit to disable telemetry.
APPLICATIONINSIGHTS_CONNECTION_STRING=

# Optional production tuning
Foundry__TimeoutSeconds=20
Foundry__MaxOutputTokens=4096
Foundry__TokenScope=https://ai.azure.com/.default
